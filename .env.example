# Database Configuration (PostgreSQL Primary)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/meramahan
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Active Profiles: dev (includes local H2 fallback & auto-seeding), prod (strict PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# JWT Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Email Service Configuration (Optional: uses console logging fallback in dev mode)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@meramahan.in

# Cloudinary Storage Configuration (Optional: uses local uploads fallback in dev mode)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api
