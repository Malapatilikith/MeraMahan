            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "send"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@meramahan.in\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"Citizen@5678\",\n  \"confirmPassword\": \"Citizen@5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/password/reset",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "password", "reset"]
            }
          }
        }
      ]
    },
