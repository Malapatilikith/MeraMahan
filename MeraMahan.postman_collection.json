        {
          "name": "Add Comment to Report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Local civic authorities were informed yesterday regarding this situation.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/{{reportId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reports", "{{reportId}}", "comments"]
            }
          }
