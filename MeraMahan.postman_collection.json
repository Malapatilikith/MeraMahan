    {
      "name": "3. Citizen Reports",
      "item": [
        {
          "name": "Get Public Reports Feed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reports"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Report Details by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Submit Citizen Report (Multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Waste accumulation near roadside junction",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Large pile of unsegregated civic garbage dumped near main cross road causing hygiene hazards for local residents.",
                  "type": "text"
                },
                {
                  "key": "categoryId",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "stateId",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "cityId",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "areaDescription",
                  "value": "Near Bus Stand, Ward 12",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reports"]
            }
          }
        },
        {
          "name": "Get My Submitted Reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/my-reports?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reports", "my-reports"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Toggle Like on Report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
